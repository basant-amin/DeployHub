# ---------------------------------------------------------------------------
# DeployHub environment variables
#
# `npm run dev:prepare` writes a working `.env.local` — including a generated local password
# and the runtime root it prepared — so this file is a reference rather than a required step.
# `.env.local` is git-ignored and must never be committed.
#
# The host DeployHub needs (data root, workspace, secrets file, Docker socket) is validated at
# startup by `src/server/runtime/startup-check.ts`, in the dev server and in the containers
# alike. Both refuse to start rather than fail later.
# ---------------------------------------------------------------------------

# Runtime environment. One of: development | test | production
# Normally set by the tooling; override only when you know why.
NODE_ENV=development

# Public base URL of the application (used for absolute links, redirects, etc.).
# Must be a valid absolute URL including protocol.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Dashboard access
# ---------------------------------------------------------------------------

# One shared password for the whole team. At least 8 characters.
# Until this is set the dashboard fails closed: every route redirects to
# /signin and no deployment can be triggered from the UI.
# Generate one with: openssl rand -hex 24
DEPLOYHUB_PASSWORD=

# Recorded as the actor on deployments triggered from the dashboard.
# A shared password identifies a team, not a person, so name the team.
DEPLOYHUB_ACTOR=dashboard

# ---------------------------------------------------------------------------
# Deployment runtime
#
# Only the ones worth setting by hand. The rest have defaults in
# `runtimeConfigFromEnv()` (`src/server/runtime/composition.ts`) — see
# `docs/docker.md`.
# ---------------------------------------------------------------------------

# Base directory for the SQLite database, the project workspaces, and
# secrets.json. It holds real runtime state, so it lives outside the working
# tree: `npm run dev:prepare` creates `~/.deployhub-dev` and records the
# resolved absolute path here.
#
# Production does not use this file. The image sets /var/lib/deployhub, and
# `sudo docs/ops/install.sh` prepares it — never run that installer on a
# development machine: it owns the paths to uid 1000, which is not your uid.
DEPLOYHUB_ROOT=

# Interface deployed containers publish on.
#
# 127.0.0.1 keeps an application reachable only through the host's reverse
# proxy, which is the safer value. 0.0.0.0 reproduces a plain `-p 3000:3000`
# and is what an existing deployment being adopted already does — matching it
# exactly is what makes the first deployment a no-op rather than a change.
DEPLOYHUB_BIND_HOST=127.0.0.1

# Scheme and port the host's proxy serves the public route on. Used by the
# post-deployment check that the release is reachable the way a user reaches it.
# These are the local values; production serves https on 443, which is also what
# `runtimeConfigFromEnv()` defaults to when they are unset.
DEPLOYHUB_PUBLIC_SCHEME=http
DEPLOYHUB_PUBLIC_PORT=3000
