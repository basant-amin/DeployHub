# ---------------------------------------------------------------------------
# DeployHub environment variables
#
# Copy this file to `.env.local` and fill in real values for local development.
# `.env.local` is git-ignored and must never be committed.
#
# All variables are validated at startup by `src/config/env.ts`.
# The app will refuse to boot if a required variable is missing or malformed.
# ---------------------------------------------------------------------------

# Runtime environment. One of: development | test | production
# Normally set by the tooling; override only when you know why.
NODE_ENV=development

# Public base URL of the application (used for absolute links, redirects, etc.).
# Must be a valid absolute URL including protocol.
NEXT_PUBLIC_APP_URL=http://localhost:3000
