# ---------------------------------------------------------------------------
# DeployHub environment variables
#
# Copy this file to `.env.local` and fill in real values for local development.
# `.env.local` is git-ignored and must never be committed.
#
# All variables are validated at startup by `src/config/env.ts`.
# The app will refuse to boot if a required variable is missing or malformed.
# ---------------------------------------------------------------------------

# Runtime environment. One of: development | test | production
# Normally set by the tooling; override only when you know why.
NODE_ENV=development

# Public base URL of the application (used for absolute links, redirects, etc.).
# Must be a valid absolute URL including protocol.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Dashboard access
# ---------------------------------------------------------------------------

# One shared password for the whole team. At least 8 characters.
# Until this is set the dashboard fails closed: every route redirects to
# /signin and no deployment can be triggered from the UI.
# Generate one with: openssl rand -hex 24
DEPLOYHUB_PASSWORD=

# Recorded as the actor on deployments triggered from the dashboard.
# A shared password identifies a team, not a person, so name the team.
DEPLOYHUB_ACTOR=dashboard

# ---------------------------------------------------------------------------
# Deployment runtime
#
# Only the ones worth setting by hand. The rest have defaults in
# `runtimeConfigFromEnv()` (`src/server/runtime/composition.ts`) and the
# container image sets DEPLOYHUB_ROOT and DEPLOYHUB_STORAGE_PATH — see
# `docs/docker.md`.
# ---------------------------------------------------------------------------

# Interface deployed containers publish on.
#
# 127.0.0.1 keeps an application reachable only through the host's reverse
# proxy, which is the safer value. 0.0.0.0 reproduces a plain `-p 3000:3000`
# and is what an existing deployment being adopted already does — matching it
# exactly is what makes the first deployment a no-op rather than a change.
DEPLOYHUB_BIND_HOST=127.0.0.1

# Scheme and port the host's proxy serves the public route on. Used by the
# post-deployment check that the release is reachable the way a user reaches it.
DEPLOYHUB_PUBLIC_SCHEME=https
DEPLOYHUB_PUBLIC_PORT=443
